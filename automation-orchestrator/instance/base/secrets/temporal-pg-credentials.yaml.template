---
# Template for temporal database credentials
# Copy this file to your overlay's secrets directory and replace placeholder values
# Note: The temporal user needs access to both 'temporal' and 'temporal_visibility' databases
apiVersion: v1
kind: Secret
metadata:
  name: temporal-pg-credentials
  annotations:
    argocd.argoproj.io/sync-wave: "1"
type: Opaque
stringData:
  host: "postgresql.automation-orchestrator.svc.cluster.local"
  port: "5432"
  database: "temporal"
  username: "temporal"
  password: "REPLACE_WITH_SECURE_PASSWORD"
  sslmode: "prefer"
