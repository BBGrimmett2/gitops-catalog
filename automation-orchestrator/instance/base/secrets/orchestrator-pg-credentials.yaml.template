---
# Template for orchestrator database credentials
# Copy this file to your overlay's secrets directory and replace placeholder values
apiVersion: v1
kind: Secret
metadata:
  name: orchestrator-pg-credentials
  annotations:
    argocd.argoproj.io/sync-wave: "1"
type: Opaque
stringData:
  host: "postgresql.automation-orchestrator.svc.cluster.local"
  port: "5432"
  database: "orchestrator"
  username: "orchestrator"
  password: "REPLACE_WITH_SECURE_PASSWORD"
  sslmode: "prefer"
